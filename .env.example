# Database - for local dev use SQLite, for production use PostgreSQL
DATABASE_URL="file:./dev.db"
# For PostgreSQL production: DATABASE_URL="postgresql://user:password@localhost:5432/nuvra?schema=public"
# Tables are created automatically on first request (set NUVRA_DB_AUTO_BOOTSTRAP=0 to disable).
# NUVRA_DB_AUTO_BOOTSTRAP=1

# Auth
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string-in-production"
JWT_SECRET="change-this-to-a-random-32-char-string-in-production"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# Storage (S3 compatible)
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="nuvra-storage"
STORAGE_REGION="us-east-1"

# Email (Resend / Postmark / SendGrid)
EMAIL_API_KEY="re_..."
EMAIL_FROM="Nuvra <noreply@nuvra.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
